# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# Spotify requires loopback redirect URIs to use 127.0.0.1 (not "localhost").
# Register this redirect URI in your Spotify app dashboard:
#   http://127.0.0.1:3000/api/auth/callback/spotify
NEXTAUTH_URL=http://127.0.0.1:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_me

# Server-only Spotify credentials (never exposed to the browser)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Optional: play-history backend (Django). Used server-side by /api/history.
SP_API_URL=http://127.0.0.1:8000/sp-api

# ---------------------------------------------------------------------------
# Backend (Django / Celery)
# ---------------------------------------------------------------------------
SECRET_KEY=replace_me_too
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sp_service
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_NAME=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
CELERY_BROKER=redis://redis:6379/0
